# Copy to .env with `npm run setup:env`, which fills the blank secrets below
# with fresh random values. Never commit .env.

# --- Database (read by Docker Compose and by the app container) ---
# POSTGRES_USER owns the database and runs migrations. In the postgres image it
# is a superuser, so the running app does NOT use it (see APP_DB_* below).
POSTGRES_USER=home_finances
POSTGRES_PASSWORD=
POSTGRES_DB=home_finances
# Least-privilege role the app connects as: data access only, no schema changes.
# `npm run db:migrate` creates it and keeps its grants current.
APP_DB_USER=home_finances_app
APP_DB_PASSWORD=
# Inside the Compose network the database host is `db`. Host-side tools would
# need 127.0.0.1:5433 (compose.debug.yaml) instead.
DATABASE_URL=
# Owner connection, used only by migrations and test setup. Never by app code.
MIGRATION_DATABASE_URL=

# --- App ---
APP_URL=http://localhost:3000
AUTH_SECRET=

# --- Token encryption (back this key up separately from database dumps) ---
TOKEN_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY_ID=v1

# --- Plaid (get Sandbox keys from the Plaid dashboard; blank = the Connect button is hidden) ---
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
# Only for banks that use OAuth (see docs/plaid-link.md). Must be on the Plaid Dashboard's
# allowed redirect URIs and have no query or fragment: an https:// URL, or in
# Sandbox only, http://localhost:3000/plaid/oauth. Leave blank otherwise.
PLAID_REDIRECT_URI=
