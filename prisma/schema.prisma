// Home Finances data model. See docs/home-finances-spec.md ("Data model").
//
// Conventions
// - Primary keys are UUIDs generated by the app.
// - Money is Decimal (exact), never Float. Plaid sign conventions are preserved
//   as received; currency is stored beside every amount.
// - Null balances mean "not reported", never zero.
// - Everything belonging to a connection (Item) is deleted with it; a household
//   cannot be deleted while it still has connections.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

enum MemberRole {
  OWNER
  MEMBER
}

model Household {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now())

  memberships  Membership[]
  plaidItems   PlaidItem[]
  accounts     Account[]
  linkAttempts LinkAttempt[]
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  // Normalised to lower case by the application before it is stored.
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships Membership[]
  sessions    Session[]
}

model Membership {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String     @db.Uuid
  householdId String     @db.Uuid
  role        MemberRole @default(MEMBER)
  createdAt   DateTime   @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([userId, householdId])
  @@index([householdId])
}

// Server-side sessions. Only a hash of the session token is stored. Task 3
// chooses the auth library and may adjust this shape in a later migration.
model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  linkAttempts LinkAttempt[]

  @@index([userId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Plaid connections
// ---------------------------------------------------------------------------

enum PlaidEnvironment {
  SANDBOX
  PRODUCTION
}

enum ItemStatus {
  // Created locally; provider exchange not yet confirmed.
  PENDING
  ACTIVE
  // Provider needs the user to re-authenticate (update mode).
  LOGIN_REQUIRED
  ERROR
  DISCONNECTED
}

model PlaidItem {
  id                    String           @id @default(uuid()) @db.Uuid
  householdId           String           @db.Uuid
  environment           PlaidEnvironment
  plaidItemId           String
  // Output of encryptToken(); embeds key id/version. Null once disconnected.
  accessTokenCiphertext String?
  institutionId         String?
  institutionName       String?
  status                ItemStatus       @default(PENDING)
  syncCursor            String?
  lastSuccessfulSyncAt  DateTime?
  // Safe, provider-defined error code only; never raw payloads.
  lastErrorCode         String?
  lastErrorAt           DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  household    Household     @relation(fields: [householdId], references: [id], onDelete: Restrict)
  accounts     Account[]
  syncRuns     SyncRun[]
  linkAttempts LinkAttempt[]

  // Separate logins at one institution are separate Items, so institution is
  // deliberately NOT part of any unique key.
  @@unique([environment, plaidItemId])
  @@index([householdId])
}

model Account {
  id                String    @id @default(uuid()) @db.Uuid
  householdId       String    @db.Uuid
  plaidItemId       String    @db.Uuid
  externalAccountId String
  name              String
  officialName      String?
  // Last digits only. Full account numbers are never stored.
  mask              String?
  type              String
  subtype           String?
  currency          String
  // Accounts missing from the provider are marked, never silently deleted.
  active            Boolean   @default(true)
  unavailableSince  DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  household    Household         @relation(fields: [householdId], references: [id], onDelete: Restrict)
  plaidItem    PlaidItem         @relation(fields: [plaidItemId], references: [id], onDelete: Cascade)
  balances     BalanceSnapshot[]
  transactions Transaction[]

  @@unique([plaidItemId, externalAccountId])
  // Lets Transaction prove its account belongs to the same Item.
  @@unique([id, plaidItemId])
  @@index([householdId])
}

enum BalanceSource {
  ACCOUNTS_GET
  BALANCE_GET
}

model BalanceSnapshot {
  id                String        @id @default(uuid()) @db.Uuid
  accountId         String        @db.Uuid
  // When this app observed the value.
  observedAt        DateTime
  // When the provider says the value was last refreshed, if it says.
  providerUpdatedAt DateTime?
  available         Decimal?      @db.Decimal(19, 4)
  current           Decimal?      @db.Decimal(19, 4)
  limit             Decimal?      @db.Decimal(19, 4)
  currency          String
  source            BalanceSource

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, observedAt(sort: Desc)])
}

model Transaction {
  id                           String    @id @default(uuid()) @db.Uuid
  accountId                    String    @db.Uuid
  plaidItemId                  String    @db.Uuid
  providerTransactionId        String
  // Exact decimal in the provider's sign convention.
  amount                       Decimal   @db.Decimal(19, 4)
  currency                     String
  date                         DateTime  @db.Date
  authorizedDate               DateTime? @db.Date
  pending                      Boolean   @default(false)
  // For a posted transaction, the pending one it replaces.
  pendingProviderTransactionId String?
  description                  String
  merchantName                 String?
  // Set when the provider reports the transaction removed.
  removedAt                    DateTime?
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  // Composite key guarantees the account belongs to this same Item.
  account Account @relation(fields: [accountId, plaidItemId], references: [id, plaidItemId], onDelete: Cascade)

  @@unique([plaidItemId, providerTransactionId])
  @@index([accountId, date(sort: Desc)])
}

// ---------------------------------------------------------------------------
// Link flow and sync bookkeeping
// ---------------------------------------------------------------------------

enum LinkAttemptStatus {
  PENDING
  COMPLETED
  FAILED
  // Provider exchange succeeded but local persistence is uncertain; needs
  // reconciliation. The consumed public token must never be retried blindly.
  NEEDS_RECONCILIATION
}

model LinkAttempt {
  id          String            @id @default(uuid()) @db.Uuid
  householdId String            @db.Uuid
  // Bound to the browser session that started it. Set null (not deleted) if
  // that session goes away, so an unfinished attempt can still be reconciled.
  sessionId   String?           @db.Uuid
  environment PlaidEnvironment
  status      LinkAttemptStatus @default(PENDING)
  // Set for update-mode attempts (reconnecting an existing Item) and once an
  // exchange creates an Item.
  plaidItemId String?           @db.Uuid
  expiresAt   DateTime
  completedAt DateTime?
  createdAt   DateTime          @default(now())

  household Household  @relation(fields: [householdId], references: [id], onDelete: Restrict)
  session   Session?   @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  plaidItem PlaidItem? @relation(fields: [plaidItemId], references: [id], onDelete: SetNull)

  @@index([householdId, status])
  @@index([expiresAt])
}

enum SyncRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

model SyncRun {
  id             String        @id @default(uuid()) @db.Uuid
  plaidItemId    String        @db.Uuid
  status         SyncRunStatus @default(RUNNING)
  startedAt      DateTime      @default(now())
  finishedAt     DateTime?
  // Provider request id and error code only; never token-bearing payloads.
  plaidRequestId String?
  errorCode      String?
  addedCount     Int           @default(0)
  modifiedCount  Int           @default(0)
  removedCount   Int           @default(0)

  plaidItem PlaidItem @relation(fields: [plaidItemId], references: [id], onDelete: Cascade)

  @@index([plaidItemId, startedAt(sort: Desc)])
}
