{
  "name": "home-finances",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "prisma generate && next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:integration": "prisma generate && vitest run --config vitest.integration.config.mts --passWithNoTests",
    "test:e2e": "playwright test",
    "setup:env": "node scripts/setup-env.mjs",
    "prebuild": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "tsx scripts/migrate.mts",
    "db:migrate:dev": "prisma migrate dev",
    "auth:bootstrap": "tsx scripts/bootstrap-user.mts"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.15",
    "next": "16.4.3",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
