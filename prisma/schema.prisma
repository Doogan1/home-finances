// Home Finances data model. See docs/home-finances-spec.md ("Data model").
//
// Conventions
// - Primary keys are UUIDs generated by the app.
// - Money is Decimal (exact), never Float. Plaid sign conventions are preserved
//   as received; currency is stored beside every amount.
// - Null balances mean "not reported", never zero.
// - Everything belonging to a connection (Item) is deleted with it; a household
//   cannot be deleted while it still has connections.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

enum MemberRole {
  OWNER
  MEMBER
}

model Household {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now())

  memberships  Membership[]
  plaidItems   PlaidItem[]
  accounts     Account[]
  linkAttempts LinkAttempt[]
}

// User, Session, AuthAccount and RateLimit are the tables Better Auth reads and
// writes (docs/auth.md explains why we use it). Their shape follows its core
// schema; ids are UUIDs (`advanced.database.generateId: "uuid"`). The password
// hash lives on the credential AuthAccount row, not on User.
model User {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  // Normalised to lower case by the application before it is stored.
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memberships  Membership[]
  sessions     Session[]
  authAccounts AuthAccount[]
}

// Named AuthAccount (not Account) because Account is a bank account here.
model AuthAccount {
  id                    String    @id @default(uuid()) @db.Uuid
  // For the "credential" provider this is the user's own id.
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  // Argon2id hash (PHC string) for the credential provider; never plaintext.
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

// Required by Better Auth's startup schema check. It holds one-time tokens for
// email verification and password reset, neither of which we enable (closed
// registration, no outbound email), so this table stays empty.
model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// Sign-in throttling counters. One row per (client bucket, path).
model RateLimit {
  id          String @id @default(uuid()) @db.Uuid
  key         String @unique
  count       Int
  lastRequest BigInt
}

model Membership {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String     @db.Uuid
  householdId String     @db.Uuid
  role        MemberRole @default(MEMBER)
  createdAt   DateTime   @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([userId, householdId])
  @@index([householdId])
}

// Server-side sessions managed by Better Auth. Revocation (logout, "sign out
// everywhere") deletes the row, so a missing row means no session. The browser
// holds only the token signed with AUTH_SECRET: a database read alone cannot
// forge a cookie.
model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  linkAttempts LinkAttempt[]

  @@index([userId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Plaid connections
// ---------------------------------------------------------------------------

enum PlaidEnvironment {
  SANDBOX
  PRODUCTION
}

enum ItemStatus {
  // Token exchanged and stored, but accounts not yet fetched successfully.
  // Safe to retry the account fetch; never the public-token exchange.
  PENDING
  ACTIVE
  // Provider needs the user to re-authenticate (update mode).
  LOGIN_REQUIRED
  ERROR
  DISCONNECTED
}

model PlaidItem {
  id                    String           @id @default(uuid()) @db.Uuid
  householdId           String           @db.Uuid
  environment           PlaidEnvironment
  plaidItemId           String
  // Output of encryptToken(); embeds key id/version. Null once disconnected.
  accessTokenCiphertext String?
  institutionId         String?
  institutionName       String?
  status                ItemStatus       @default(PENDING)
  // Plaid's transactions/sync cursor. Moves only in the same database
  // transaction that applies the data it covers. Null until a first sync
  // returns data (Plaid answers "not ready" with an empty cursor).
  syncCursor            String?
  // Bumped each time the cursor moves; a commit proves nothing else moved it.
  syncCursorVersion     Int              @default(0)
  // A sync holds a lease while it runs: a random token plus an expiry. A crashed
  // worker's lease simply expires; a stale holder's commit is rejected because
  // its token no longer matches.
  syncLeaseToken        String?
  syncLeaseExpiresAt    DateTime?
  lastSuccessfulSyncAt  DateTime?
  // Safe, provider-defined error code only; never raw payloads.
  lastErrorCode         String?
  lastErrorAt           DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  household    Household     @relation(fields: [householdId], references: [id], onDelete: Restrict)
  accounts     Account[]
  syncRuns     SyncRun[]
  linkAttempts LinkAttempt[]

  // Separate logins at one institution are separate Items, so institution is
  // deliberately NOT part of any unique key.
  @@unique([environment, plaidItemId])
  @@index([householdId])
}

model Account {
  id                String    @id @default(uuid()) @db.Uuid
  householdId       String    @db.Uuid
  plaidItemId       String    @db.Uuid
  externalAccountId String
  name              String
  officialName      String?
  // Last digits only. Full account numbers are never stored.
  mask              String?
  type              String
  subtype           String?
  currency          String
  // Accounts missing from the provider are marked, never silently deleted.
  active            Boolean   @default(true)
  unavailableSince  DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  household    Household         @relation(fields: [householdId], references: [id], onDelete: Restrict)
  plaidItem    PlaidItem         @relation(fields: [plaidItemId], references: [id], onDelete: Cascade)
  balances     BalanceSnapshot[]
  transactions Transaction[]

  @@unique([plaidItemId, externalAccountId])
  // Lets Transaction prove its account belongs to the same Item.
  @@unique([id, plaidItemId])
  @@index([householdId])
}

enum BalanceSource {
  ACCOUNTS_GET
  BALANCE_GET
}

model BalanceSnapshot {
  id                String        @id @default(uuid()) @db.Uuid
  accountId         String        @db.Uuid
  // When this app observed the value.
  observedAt        DateTime
  // When the provider says the value was last refreshed, if it says.
  providerUpdatedAt DateTime?
  available         Decimal?      @db.Decimal(19, 4)
  current           Decimal?      @db.Decimal(19, 4)
  limit             Decimal?      @db.Decimal(19, 4)
  currency          String
  source            BalanceSource

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, observedAt(sort: Desc)])
}

model Transaction {
  id                           String    @id @default(uuid()) @db.Uuid
  accountId                    String    @db.Uuid
  plaidItemId                  String    @db.Uuid
  providerTransactionId        String
  // Exact decimal in the provider's sign convention.
  amount                       Decimal   @db.Decimal(19, 4)
  currency                     String
  date                         DateTime  @db.Date
  authorizedDate               DateTime? @db.Date
  pending                      Boolean   @default(false)
  // For a posted transaction, the pending one it replaces.
  pendingProviderTransactionId String?
  description                  String
  merchantName                 String?
  // Set when the provider reports the transaction removed.
  removedAt                    DateTime?
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  // Composite key guarantees the account belongs to this same Item.
  account Account @relation(fields: [accountId, plaidItemId], references: [id, plaidItemId], onDelete: Cascade)

  @@unique([plaidItemId, providerTransactionId])
  @@index([accountId, date(sort: Desc)])
}

// ---------------------------------------------------------------------------
// Link flow and sync bookkeeping
// ---------------------------------------------------------------------------

enum LinkAttemptKind {
  // Connecting a new bank: the public token is exchanged for an access token.
  CONNECT
  // Update mode for an existing Item: the access token does not change, so no
  // exchange happens; completing it just re-checks the connection.
  RECONNECT
}

enum LinkAttemptStatus {
  PENDING
  // Claimed by one exchange request. A public token can be exchanged once, so
  // claiming is an atomic PENDING -> EXCHANGING update; a second request loses.
  EXCHANGING
  COMPLETED
  FAILED
  // Provider exchange succeeded but local persistence is uncertain; needs
  // reconciliation. The consumed public token must never be retried blindly.
  NEEDS_RECONCILIATION
}

model LinkAttempt {
  id                   String            @id @default(uuid()) @db.Uuid
  kind                 LinkAttemptKind   @default(CONNECT)
  householdId          String            @db.Uuid
  // Bound to the browser session that started it. Set null (not deleted) if
  // that session goes away, so an unfinished attempt can still be reconciled.
  sessionId            String?           @db.Uuid
  environment          PlaidEnvironment
  status               LinkAttemptStatus @default(PENDING)
  // Set for update-mode attempts (reconnecting an existing Item) and once an
  // exchange creates an Item.
  plaidItemId          String?           @db.Uuid
  expiresAt            DateTime
  completedAt          DateTime?
  createdAt            DateTime          @default(now())
  // Days of transaction history requested when the link token was created.
  requestedHistoryDays Int?
  // Plaid's own id for the Item, recorded as soon as the exchange succeeds so
  // an exchange whose local save failed can be reconciled or cleaned up.
  providerItemId       String?
  // The Plaid link token, encrypted, kept only so an OAuth bank's redirect page
  // can reopen Link with the SAME token. Cleared the moment the attempt ends
  // (completed, failed or expired).
  linkTokenCiphertext  String?
  // Safe, app-defined failure code only; never provider payloads.
  errorCode            String?

  household Household  @relation(fields: [householdId], references: [id], onDelete: Restrict)
  session   Session?   @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  plaidItem PlaidItem? @relation(fields: [plaidItemId], references: [id], onDelete: SetNull)

  @@index([householdId, status])
  @@index([expiresAt])
}

enum SyncRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

model SyncRun {
  id             String        @id @default(uuid()) @db.Uuid
  plaidItemId    String        @db.Uuid
  status         SyncRunStatus @default(RUNNING)
  startedAt      DateTime      @default(now())
  finishedAt     DateTime?
  // Provider request id and error code only; never token-bearing payloads.
  plaidRequestId String?
  errorCode      String?
  addedCount     Int           @default(0)
  modifiedCount  Int           @default(0)
  removedCount   Int           @default(0)
  // Plaid's own statement of how complete the data is (for example NOT_READY).
  providerStatus String?
  pageCount      Int           @default(0)

  plaidItem PlaidItem @relation(fields: [plaidItemId], references: [id], onDelete: Cascade)

  @@index([plaidItemId, startedAt(sort: Desc)])
}
